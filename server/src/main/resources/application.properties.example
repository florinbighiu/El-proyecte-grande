# Copy this file to "application.properties" (same folder) and fill in your own
# Supabase project's connection details. application.properties is gitignored so
# your credentials never get committed.
#
# Alternatively, leave application.properties with placeholder fallbacks and
# export DB_URL / DB_USERNAME / DB_PASSWORD as environment variables — both are
# read via ${VAR:fallback} syntax, so env vars always win when present.

spring.datasource.url=${DB_URL:jdbc:postgresql://<your-pooler-host>:5432/postgres?sslmode=require}
spring.datasource.username=${DB_USERNAME:<your-db-username>}
spring.datasource.password=${DB_PASSWORD:<your-db-password>}
spring.datasource.driver-class-name=org.postgresql.Driver

spring.datasource.hikari.maximum-pool-size=${DB_POOL_MAX_SIZE:5}
spring.datasource.hikari.minimum-idle=2
spring.datasource.hikari.connection-timeout=20000
spring.datasource.hikari.idle-timeout=300000
spring.datasource.hikari.max-lifetime=900000

# update = preserves existing data; use create only for first-time setup
spring.jpa.hibernate.ddl-auto=update

spring.jpa.database-platform=org.hibernate.dialect.PostgreSQLDialect
spring.jpa.properties.hibernate.temp.use_jdbc_metadata_defaults=false

spring.jpa.open-in-view=false

# --- Mail (password-reset emails) ---
spring.mail.host=${MAIL_HOST:smtp.gmail.com}
spring.mail.port=${MAIL_PORT:587}
spring.mail.username=${MAIL_USERNAME:<your-smtp-username>}
spring.mail.password=${MAIL_PASSWORD:<your-smtp-app-password>}
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true
app.mail.from=${MAIL_FROM:<your-from-address>}

app.frontend.base-url=${FRONTEND_BASE_URL:http://localhost:5173}
